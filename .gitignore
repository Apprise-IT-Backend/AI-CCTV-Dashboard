.npm
# package-lock.json is usually committed for stability, 
# but uncomment the next line if you prefer to ignore it
# package-lock.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/

# AI / Machine Learning Models
# Ignore large model weights
*.pt
*.pth
*.h5
*.onnx
*.tflite
*.weights
*.bin

# MediaMTX
mediamtx/mediamtx.exe
mediamtx/mediamtx.zip
mediamtx/mediamtx.log
mediamtx/mediamtx.err
mediamtx/*.m3u8
mediamtx/*.ts
mediamtx/*.mp4

# FFmpeg — the agent auto-downloads this into agent/ on first Windows run.
# 20-40 MB portable binary; other platforms install via brew/apt.
agent/ffmpeg.exe
agent/ffmpeg.zip
agent/ffmpeg
agent/ffprobe.exe
agent/ffprobe

# Runtime caches — regenerated every session, never worth committing.
# Analyze Video: uploads + annotated outputs (hundreds of MB per job).
face-ai/analyze_jobs/
# Live pipeline: per-incident JPEG snapshots.
face-ai/snapshots/

# Log files (keep noise out of PRs)
*.log
logs/

# Project Specific
# Enrollments (Ignore user images but keep folder structure)
face-ai/enrollments/*.jpg
face-ai/enrollments/*.jpeg
face-ai/enrollments/*.png
!face-ai/enrollments/.gitkeep

# Local configurations / test files
backend/add_camera.json
mediamtx/test_path.json

